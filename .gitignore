# =========================
# RentMaster Root .gitignore
# =========================

# ---- IDE ----
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Backend (Spring Boot / Maven) ----
backend/target/
backend/*.jar
backend/*.war
backend/*.class
backend/.mvn/wrapper/maven-wrapper.jar
backend/mvnw
backend/mvnw.cmd

# ---- Frontend (React / Vite / Node) ----
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ---- Logs ----
*.log
logs/

# ---- Misc ----
*.bak
*.tmp
*.swp
